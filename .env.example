# ==============================================================================
# PRESET A: 100% Local, Offline & Private Mode (Zero Cost, < 1.5GB Footprint)
# ==============================================================================
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen2.5:1.5b
TRANSCRIPTION_MODEL=whisper-base

# ==============================================================================
# PRESET B: Free Cloud Tier Mode (Groq / Gemini)
# ==============================================================================
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your_free_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# TRANSCRIPTION_MODEL=whisper-large-v3

# ==============================================================================
# Public APIs & Linguistic Translation (https://github.com/public-apis/public-apis)
# ==============================================================================
LIBRETRANSLATE_BASE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# Audio Recording Config (AAC-LC, 44.1kHz, 128kbps - < 2% CPU)
DEFAULT_AUDIO_ENCODER=aacLc
AUDIO_SAMPLE_RATE=44100
AUDIO_BITRATE=128000
